# Copy to .env for local runs (".env" is git-ignored). In GitHub, add these as Actions secrets instead.
# Load locally with:  set -a; source .env; set +a
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your-16-char-gmail-app-password
REPORT_TO=you@gmail.com

# Optional: Alpaca PAPER account (keys start with PK). Leave empty for reports only.
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
ENABLE_PAPER_ORDERS=false
